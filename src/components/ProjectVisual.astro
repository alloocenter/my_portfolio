          <rect x="16" y="176" width="138" height="36" rx="5" class="m-row" />
          <text x="26" y="198" class="m-fg" font-size="10.5">{fr ? 'Reporting live' : 'Live reports'}</text>
          <rect x="16" y="222" width="138" height="36" rx="5" class="m-row" />
          <text x="26" y="244" class="m-ok" font-size="10.5">{fr ? 'Équipes actives ✓' : 'Daily team use ✓'}</text>
        </g>

        {/* 2. Livraison */}
        <g transform="translate(215 62)" class="pmock__focus">
          <rect width="170" height="278" rx="8" class="m-card m-card--accent" />
          <text x="16" y="28" class="m-mono m-accent" font-size="9.5">02 · {fr ? 'LIVRAISON' : 'DELIVERY'}</text>
          <text x="16" y="50" class="m-title" font-size="15">{fr ? 'Suivi colis' : 'Live tracking'}</text>
          {/* Mini carte trajet */}
          <rect x="16" y="70" width="138" height="122" rx="6" class="m-video" />
          <path d="M36 164 C 66 150, 74 114, 130 94" stroke="#f08080" stroke-width="2.5" stroke-dasharray="4 4" fill="none" />
          <circle cx="36" cy="164" r="5" fill="#efeae0" />
