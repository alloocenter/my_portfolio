          <text x="26" y="244" class="m-ok" font-size="10">{fr ? 'Livré en 25 min' : 'ETA 25 min'}</text>
        </g>

        {/* 3. E-commerce */}
        <g transform="translate(400 62)">
          <rect width="170" height="278" rx="8" class="m-card" />
          <text x="16" y="28" class="m-mono m-accent" font-size="9.5">03 · {fr ? 'BOUTIQUE' : 'STORE'}</text>
