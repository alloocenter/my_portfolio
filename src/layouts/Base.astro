---
/**
 * Layout racine — Direction « Grand Livre / Swiss Ledger ».
 * Polices éditoriales auto-hébergées (Instrument Serif, Bricolage Grotesque, IBM Plex Mono),
 * SEO complet (canonical, hreflang, OG, JSON-LD Person), thème clair papier par défaut sans FOUC.
 */
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import displayWoff2 from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import serifItalicWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/base.css';

import { type Lang, useTranslations } from '../i18n/ui';
import { profile } from '../data/profile';
import { allSkills } from '../data/skills';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const urlFr = new URL('/', site).href;
const urlEn = new URL('/en/', site).href;
const ogImage = new URL(lang === 'fr' ? '/og-fr.png' : '/og-en.png', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: urlFr,
  image: new URL('/og-fr.png', site).href,
  email: `mailto:${profile.email}`,
  jobTitle: profile.jobTitle[lang],
  description,
  address: { '@type': 'PostalAddress', addressLocality: 'Abidjan', addressCountry: 'CI' },
  worksFor: { '@type': 'Organization', name: 'MediaSoft Lafayette' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Institut Universitaire Lucas' },
    { '@type': 'CollegeOrUniversity', name: 'Institut Supérieur d’Informatique et de Management' },
    { '@type': 'CollegeOrUniversity', name: 'Faculté des Sciences Économiques et de Gestion' },
  ],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'AWS Certified Cloud Practitioner' },
    { '@type': 'EducationalOccupationalCredential', name: 'Python Project for Data Engineering' },
  ],
  knowsLanguage: ['fr', 'en'],
  knowsAbout: allSkills,
  sameAs: [profile.socials.linkedin, profile.socials.github],
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="fr" href={urlFr} />
          <link rel="alternate" hreflang="en" href={urlEn} />
          <link rel="alternate" hreflang="x-default" href={urlFr} />
        </>
      )
    }

    <meta name="theme-color" content="#fbf7f6" data-theme-color />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf7f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121010" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Polices critiques préchargées -->
    <link rel="preload" href={displayWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.jobTitle[lang]}`} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="profile:first_name" content={profile.firstName} />
    <meta property="profile:last_name" content={profile.lastName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Thème clair papier par défaut (sans flash si mode sombre mémorisé) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var theme = 'light';
        try {
          if (localStorage.getItem('theme') === 'dark') theme = 'dark';
        } catch (e) {}
        d.setAttribute('data-theme', theme);
        var tc = document.querySelector('meta[data-theme-color]');
        if (tc) tc.setAttribute('content', theme === 'dark' ? '#121010' : '#fbf7f6');
        d.classList.add('js');
        setTimeout(function () {
          if (!window.__revealReady) d.classList.add('reveal-fallback');
        }, 2500);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <!-- Curseur éditorial contextuel (desktop souris uniquement) -->
    <div class="ed-cursor" aria-hidden="true" data-cursor-el>
      <span class="ed-cursor__label" data-cursor-label></span>
    </div>
    <!-- Mini-toast éditorial (façon Sonner, sans dépendance) -->
    <div
      class="ed-toast"
      role="status"
      aria-live="polite"
      data-toast
      data-msg-email={t('toast.emailCopied')}
      data-msg-cv={t('toast.cvDownload')}
      hidden
    >
      <span class="ed-toast__dot" aria-hidden="true"></span>
      <span class="ed-toast__text" data-toast-text></span>
    </div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
