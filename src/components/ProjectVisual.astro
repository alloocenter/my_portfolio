          <rect x="16" y="70" width="138" height="74" rx="6" class="m-video" />
          <rect x="52" y="88" width="66" height="38" rx="4" class="m-card m-card--accent" />
          <text x="16" y="168" class="m-fg" font-size="12" font-weight="600">{fr ? 'Catalogue & stocks' : 'Catalogue & stock'}</text>
          <text x="16" y="186" class="m-muted" font-size="10">{fr ? 'Paiement en ligne' : 'Online checkout'}</text>
          <rect x="16" y="216" width="138" height="34" rx="17" class="m-btn-accent" />
          <text x="85" y="237" text-anchor="middle" class="m-btn-txt" font-size="11">
